# sdv fstab

#<src>                                                 <mnt_point>            <type>  <mnt_flags and options>                            <fs_mgr_flags>
system                                                 /system                 ext4    ro,barrier=1,discard,errors=panic                    wait,logical,first_stage_mount,slotselect
system_ext                                             /system_ext             ext4    ro,barrier=1,discard                                 wait,logical,first_stage_mount,slotselect
vendor                                                 /vendor                 ext4    ro,barrier=1,discard,errors=panic                    wait,logical,first_stage_mount,slotselect
system_dlkm                                            /system_dlkm            ext4    ro,barrier=1,discard                                 wait,logical,first_stage_mount,slotselect
vendor_dlkm                                            /vendor_dlkm            ext4    ro,barrier=1,discard                                 wait,logical,first_stage_mount,slotselect
/dev/block/by-name/metadata                            /metadata               f2fs    noatime,nosuid,nodev,discard                         wait,formattable,first_stage_mount,check
/dev/block/by-name/userdata                            /data                   f2fs    rw,noatime,nosuid,nodev                              wait,check,quota,reservedsize=128M
/dev/block/persist                                     /mnt/vendor/persist     ext4    rw,noatime                                           defaults
/dev/block/by-name/misc                                /misc                   emmc    defaults                                             defaults
/dev/block/modem                                       /vendor/firmware_mnt    vfat    ro,shortname=lower,uid=0,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0               defaults,slotselect
